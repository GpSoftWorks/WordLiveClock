<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WordLiveClock.Views.HomePageView"
             Title="World Clock"
             BackgroundColor="#FFFFFF">
    <Grid RowDefinitions="Auto, *, Auto" Padding="15">
        <!-- Header Section -->
        <Label Grid.Row="0"
               Text="Global Business Time Zones"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#333"
               HorizontalOptions="Center"
               Padding="10" />

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1" VerticalOptions="FillAndExpand">
            <CollectionView ItemsSource="{Binding CityClocks}"
                            SelectionMode="None"
                            VerticalOptions="FillAndExpand">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="12" Padding="15" Margin="5"
                               BackgroundColor="#F9F9F9" BorderColor="#DDD">
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, *" Padding="10">
                                <!-- Country Name -->
                                <Label Grid.Row="0" Grid.ColumnSpan="2"
                                       Text="{Binding CountryName}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#1A1A1A"/>

                                <!-- Country Language -->
                                <Label Grid.Row="1" Grid.Column="0" 
                                       Text="Language:" 
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#555" />
                                <Label Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding CountryLanguage}" 
                                       FontSize="14"
                                       TextColor="#555" />

                                <!-- Date -->
                                <Label Grid.Row="2" Grid.Column="0" 
                                       Text="Date:" 
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#555" />
                                <Label Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding Date}" 
                                       FontSize="14"
                                       TextColor="#555" />

                                <!-- Time -->
                                <Label Grid.Row="3" Grid.Column="0" 
                                       Text="Time:" 
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#555" />
                                <Label Grid.Row="3" Grid.Column="1" 
                                       Text="{Binding Time}" 
                                       FontSize="14"
                                       TextColor="#555" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Footer Section -->
        <Frame Grid.Row="2" Padding="20" BackgroundColor="#F4F4F9" CornerRadius="12" Margin="0,10,0,0">
            <StackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="World Live Clock"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#2F2F2F" />

                <Label Text="Version: {Binding VersionNumber}"
                       FontSize="12"
                       TextColor="#666" />

                <Label Text="Developed by GpSoftWorks"
                       FontSize="12"
                       TextColor="#666" />

                <Label Text="Contact: gpsoftworks@gmail.com"
                       FontSize="12"
                       TextColor="#666" />
            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>
